          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingType\": \"wedding\",\n  \"addressId\": \"{{addressId}}\",\n  \"eventName\": \"Ananya & Rohan Sangeet & Mehndi Night\",\n  \"brideName\": \"Ananya Verma\",\n  \"groomName\": \"Rohan Singhania\",\n  \"numberOfPeople\": 6,\n  \"selectedDesigns\": [\n    {\n      \"designId\": \"60d5ec49f1b2c8b1f8e4e1a1\",\n      \"designName\": \"Royal Rajasthani Bridal Full Hand\",\n      \"designImage\": \"https://images.unsplash.com/photo-1596704017254-9b121068fb31\",\n      \"price\": 4500,\n      \"quantity\": 1,\n      \"notes\": \"Dark stain cone preference\"\n    },\n    {\n      \"designId\": \"60d5ec49f1b2c8b1f8e4e1a2\",\n      \"designName\": \"Arabic Floral Guest Mehndi\",\n      \"designImage\": \"https://images.unsplash.com/photo-1560066984-138dadb4c035\",\n      \"price\": 800,\n      \"quantity\": 5,\n      \"notes\": \"Both side palm for bridesmaids\"\n    }\n  ],\n  \"selectedPackage\": {\n    \"packageId\": \"60d5ec49f1b2c8b1f8e4e1a3\",\n    \"packageName\": \"Grand Wedding Mehndi Package\",\n    \"description\": \"Includes Bridal both hands & feet + 5 guests\",\n    \"price\": 8500\n  },\n  \"referencePhotos\": [\n    {\n      \"url\": \"https://images.unsplash.com/photo-1596704017254-9b121068fb31\",\n      \"originalName\": \"bride_design_ref1.jpg\"\n    }\n  ],\n  \"customerRequirements\": \"Natural organic henna only. Require 2 senior artists.\",\n  \"specialInstructions\": \"Ceremony begins at 4:00 PM promptly.\",\n  \"bookingSlots\": [\n    {\n      \"date\": \"2026-11-20T00:00:00.000Z\",\n      \"startTime\": \"15:30\",\n      \"endTime\": \"20:00\",\n      \"artistCount\": 2\n    }\n  ],\n  \"artistCharge\": 500,\n  \"travelCharge\": 300,\n  \"discount\": 500,\n  \"tax\": 250\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            },
            "description": "Create a new mehndi booking request with selected designs, slots, and venue address. Initial status: pending."
          }
        },
